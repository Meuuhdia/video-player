{
  "name": "@meuuhdia/video-player",
  "version": "1.2.1",
  "description": "Accessible HTML5 video player with captions, subtitles, text transcript and audio description (recorded or spoken by speech synthesis). Built for WCAG, no dependencies.",
  "type": "module",
  "main": "meuuhdia.js",
  "author": "Séverine Féret",
  "license": "GPL-2.0-or-later",
  "exports": {
    ".": "./meuuhdia.js"
  },
  "files": [
    "meuuhdia-css.js",
    "meuuhdia.js",
    "locale",
    "modules",
    "icons.js"
  ],
  "scripts": {
    "build": "node buildMeuuhdiaStyles",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meuuhdia/video-player.git"
  },
  "keywords": [
    "video",
    "video-player",
    "html5-video",
    "player",
    "accessibility",
    "accessible",
    "a11y",
    "wcag",
    "rgaa",
    "captions",
    "subtitles",
    "webvtt",
    "transcript",
    "audio-description",
    "screen-reader",
    "speech-synthesis",
    "inclusive"
  ],
  "homepage": "https://meuuhdia.buocennig.fr",
  "bugs": {
    "url": "https://github.com/Meuuhdia/video-player/issues"
  },
  "devDependencies": {
    "sass": "^1.80.7"
  }
}
